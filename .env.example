# 后端启动前注入的环境变量示例
# 复制为 .env 后填入真值（本地开发）；.env 已加入 .gitignore
# Spring Boot 通过 application.yaml 中的 spring.config.import 自动加载仓库根的 .env

# ---------- 数据库 ----------
DB_URL=jdbc:postgresql://localhost:5432/nexus-forge?serverTimezone=UTC
DB_USERNAME=postgres
DB_PASSWORD=your-strong-password

# ---------- JWT ----------
# 至少 32 字节，可用： openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000

# ---------- 存储 ----------
STORAGE_VENDOR=rustfs
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexus-forge
MINIO_PATH_STYLE=true

# RustFS（按需,自建对象存储,S3 兼容,Apache 2.0）
# 启用: STORAGE_VENDOR=rustfs
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=nexus-forge
RUSTFS_PATH_STYLE=true

# 阿里云 OSS（按需）
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_BUCKET=
ALIYUN_CDN_DOMAIN=

# 腾讯云 COS（按需）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_BUCKET=

# ---------- AI 用户私 Key 加解密主密钥(可选) ----------
# 用途:加密 user_ai_preference.encrypted_api_key 列(AES-256-GCM)
# 缺省:降级为 jwt.secret 派生
# 生成(任选其一):
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}) -as [byte[]])
#   bash:       openssl rand -base64 48
SPRING_AI_PREFERENCE_MASTER_KEY=
