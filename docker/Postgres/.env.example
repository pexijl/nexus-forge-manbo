# Postgres 本地编排环境变量样例
# 复制为 .env 后填值;.env 已被 .gitignore 忽略
#
# 业务侧 nexus-forge-web 的 application-dev.yaml 通过 DB_URL / DB_USERNAME / DB_PASSWORD 读取,
# 端口必须与 compose 中映射一致(默认 5432)。
#
# DHI pgvector 镜像不允许空密码 —— POSTGRES_PASSWORD 是必填项。

# 必填(生产环境务必替换为强随机)
# 生成方式: openssl rand -base64 24
POSTGRES_PASSWORD=your-strong-postgres-password

# 可选,业务侧 .env 中 DB_USERNAME 默认 postgres
POSTGRES_USER=postgres

# 可选,业务侧 .env 中 DB_URL 默认数据库 nexus-forge
POSTGRES_DB=nexus-forge
